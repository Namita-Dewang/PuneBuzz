# Matches the credentials in ../docker-compose.yml
DATABASE_URL=postgres://pune:pune@localhost:5432/pune_events

# Use a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Used by npm test. Must be a separate database whose name ends in _test;
# the tests truncate every table. Created automatically if missing.
TEST_DATABASE_URL=postgres://pune:pune@localhost:5432/pune_events_test

PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Reverse proxies in front of the API: 0 locally, 1 on Render/Railway.
# Wrong value = rate limiting keys on the proxy's IP (everyone shares one limit)
# or trusts a spoofable X-Forwarded-For header.
TRUST_PROXY=0

# Per-IP auth rate limits: failed logins per 15 min, sign-ups per hour
AUTH_LOGIN_MAX=10
AUTH_REGISTER_MAX=10
# RSVP + cancel actions per logged-in user per 10 min
RSVP_MAX=20
